{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ae/preference-record",
  "x-version": "1.0.0",
  "description": "One chosen preference on one device; defaults are not recorded.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "sound",
            "microphoneOn",
            "cameraOn"
          ]
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "language",
            "cameraDeviceId",
            "microphoneDeviceId"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ],
  "x-ourapps-modules": {}
}
